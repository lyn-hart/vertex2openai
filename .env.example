# Adapter client auth (required for callers: OpenAI Bearer / Anthropic x-api-key)
API_KEY=change_me

# Upstream Vertex auth — choose ONE of the three:
# 1) Express API key(s), comma-separated
VERTEX_EXPRESS_API_KEY=

# 2) Service account JSON content (one object, or multiple comma-separated)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# 3) Directory of service account .json files (docker-compose mounts ./credentials)
# CREDENTIALS_DIR=/app/credentials
