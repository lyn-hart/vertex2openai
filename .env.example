# ── Required ────────────────────────────────────────────────────────────────

# API key that clients must present (Authorization: Bearer ... or x-api-key: ...).
# No default — the server refuses to start when unset.
PROXY_API_KEY=change_me

# Vertex Express API key(s), comma-separated. Get one at:
# https://cloud.google.com/vertex-ai/generative-ai/docs/express-mode/overview
EXPRESS_API_KEYS=

# ── Optional ────────────────────────────────────────────────────────────────

# Express key rotation strategy: random (default) or roundrobin
# KEY_ROTATION=random

# Log level: DEBUG, INFO (default), WARNING, ERROR
# LOG_LEVEL=INFO

# Fake streaming (emit the full response as SSE chunks): true / false
# FAKE_STREAMING=false
# FAKE_STREAMING_INTERVAL=1.0

# Upstream 429 retries (retries after the first attempt) and fixed interval in ms
# RETRY_COUNT=3
# RETRY_INTERVAL_MS=1000

# Remote model list JSON (must contain a vertex_express_models array).
# On fetch failure the built-in list in app/catalog.py is used.
# MODELS_CONFIG_URL=

# Outbound proxy for upstream Google API calls (http/https/socks5)
# PROXY_URL=

# Custom CA bundle for upstream TLS verification
# SSL_CERT_FILE=
